# Dataset (overrides SABR config.py so you don't need to edit it manually)
# Options: FCC-16, FCC-18, Oboe, Puffer-21, Puffer-22, HSR,
#          Norway3G, Lumos4G, Lumos5G, SolisWi-Fi, Ghent, Lab,
#          ABRBench-3G, ABRBench-4G+
# Leave empty to use whatever _DATASET is set in env/SABR/config.py
DATASET=FCC-18

# LLM Configuration (required for evolution)
# NOTE: endpoint is hostname only — EoH appends /v1/chat/completions internally
LLM_API_ENDPOINT=api.deepseek.com
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat

# Local LLM (set LLM_USE_LOCAL=true to use instead of remote API)
LLM_USE_LOCAL=false
LLM_LOCAL_URL=http://localhost:8000

# Evolution Parameters
EC_N_POP=10
EXP_N_PROC=4
